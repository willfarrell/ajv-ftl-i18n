{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"testRunner": "command",
	"commandRunner": {
		"command": "chmod +x cli.js && npm run build && node --test --test-force-exit ./test/*.js ./*.test.js"
	},
	"coverageAnalysis": "off",
	"disableTypeChecks": false,
	"mutate": ["cli.js", "index.js", "transpile.js"],
	"reporters": ["progress", "clear-text"],
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"tempDirName": "/tmp/stryker/ajv-ftl-i18n"
}
