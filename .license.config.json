{
	"license": ".license.template",
	"licenseFormats": {
		"js|ts": {
			"eachLine": {
				"prepend": "// "
			}
		}
	},
	"ignoreFile": ".gitignore",
	"ignore": [
		".github/**/*",
		".husky/**/*",
		"fixtures/*",
		"locale/**/*",
		"commitlint.config.cjs",
		"LICENSE",
		".license.template",
		"stryker.config.*",
		"**/.gitignore",
		"**/.npmrc",
		"**/*.fuzz.js",
		"**/*.bench.js",
		"**/*.test.js",
		"test/*",
		"**/*.md",
		"**/*.yml",
		"**/*.yaml",
		"bin/*",
		".DS_Store"
	]
}
