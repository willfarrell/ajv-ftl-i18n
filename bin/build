#!/usr/bin/env bash
set -euo pipefail

srcDir=./locale/
destDir=./locale/

writeTypes() {
	cat > "${1}" <<'EOF'
declare const localize: (
	errors:
		| Array<{
				keyword: string;
				message?: string;
				params?: Record<string, unknown>;
		  }>
		| null
		| undefined,
) => void;
export default localize;
EOF
}

for file in "${srcDir}"*.ftl; do
	locale="$(basename "${file%.ftl}")"
	node cli.js "${file}" --output "${destDir}${locale}.js" --locale "${locale}"
	writeTypes "${destDir}${locale}.d.ts"
done
