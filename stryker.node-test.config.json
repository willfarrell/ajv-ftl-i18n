{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"plugins": [
		"/Users/willfarrell/Development/github/stryker-js/packages/node-test-runner/dist/src/index.js"
	],
	"testRunner": "node-test",
	"nodeTest": {
		"testFiles": ["test/*.js", "*.test.js"]
	},
	"coverageAnalysis": "perTest",
	"mutate": ["program.js", "index.js", "transpile.js"],
	"reporters": ["progress", "clear-text"],
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"tempDirName": "/tmp/stryker/ajv-ftl-i18n-node-test"
}
